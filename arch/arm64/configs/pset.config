CONFIG_VIRTIO_VSOCKETS=y
CONFIG_ZONE_DEVICE=y
CONFIG_CMA_SIZE_MBYTES=0
CONFIG_PID_IN_CONTEXTIDR=y
CONFIG_CORESIGHT=m
CONFIG_CORESIGHT_SOURCE_ETM4X=m
CONFIG_CORESIGHT_TRBE=m
CONFIG_KEXEC=y
CONFIG_KEXEC_FILE=y
CONFIG_KFENCE=y
CONFIG_PROC_PAGE_MONITOR=y
CONFIG_PROC_VMCORE=y
CONFIG_GENERIC_IRQ_DEBUGFS=y
CONFIG_ARM_CCN=n
CONFIG_ARM_CMN=n
CONFIG_DEVICE_PRIVATE=y
CONFIG_RUNTIME_TESTING_MENU=y
CONFIG_TEST_HMM=m
CONFIG_SAMPLES=y
CONFIG_SAMPLE_ARM_CCA_TEST_SUITE=m
CONFIG_SWIOTLB_DYNAMIC=y

#
# Enable TRACERS
#
CONFIG_FTRACE=y
CONFIG_BOOTTIME_TRACING=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_PROFILER=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_KPROBE_EVENTS=y
# end of Enable TRACERS

#
# CXL
#
CONFIG_CXL_BUS=y
CONFIG_CXL_PCI=y
CONFIG_CXL_MEM_RAW_COMMANDS=y
CONFIG_CXL_ACPI=y
CONFIG_CXL_PMEM=y
CONFIG_CXL_MEM=y
CONFIG_CXL_PORT=y
CONFIG_CXL_SUSPEND=y
CONFIG_CXL_REGION=y
CONFIG_CXL_PMU=y
CONFIG_DEV_DAX_CXL=y
CONFIG_CXL_ACCEL_VFIO_PCI=y

#
# Not required for PSET
#
CONFIG_WWAN=n
CONFIG_MHI_BUS=n
CONFIG_VEXPRESS_CONFIG=n
CONFIG_MTD_HYPERBUS=n
CONFIG_HISI_PMU=n
CONFIG_SOC_TI=n
CONFIG_RPMSG_QCOM_GLINK_RPM=n
CONFIG_MMC_SDHCI_XENON=n
CONFIG_MMC_SDHCI=n
CONFIG_MMC_DW=n
CONFIG_BCM_SBA_RAID=n
CONFIG_FSL_EDMA=n
CONFIG_MV_XOR_V2=n
CONFIG_DW_EDMA=n
CONFIG_QCOM_HIDMA_MGMT=n
CONFIG_QCOM_HIDMA=n
CONFIG_POWER_SEQUENCING_QCOM_WCN=n
CONFIG_GREYBUS=n
CONFIG_ATA=n

# Enable ZONE_DEVICE and DAX infrastructure
CONFIG_DEV_DAX=y
CONFIG_DEV_DAX_PMEM=y
CONFIG_DEV_DAX_KMEM=y

